# Server Configuration
NODE_ENV=development
PORT=5000

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=healthcare_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_SSL=false

# Optional connection string (overrides individual DB settings if provided)
# DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/healthcare_db

# Separate Test Database Configuration (Used when running integration tests)
# TEST_DB_NAME=healthcare_test_db

# Security & JWT Configuration
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_characters
JWT_EXPIRES_IN=24h

# CORS Configuration (comma-separated origins allowed to make requests)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
